<section class="resource-console glass" aria-labelledby="resource-title">
  <div class="resource-head"><div><span class="eyebrow">DUCK STUDIO / BIBLIOTECA</span><h2 id="resource-title">Recursos sob controle.</h2><p>Metadados versionados agora podem ser auditados no mesmo espaço.</p></div><button class="secondary" id="resource-refresh" type="button">Atualizar ↻</button></div>
  <div id="resource-list" class="resource-list"><span class="ops-muted">Aguardando sessão autenticada…</span></div>
  <p id="resource-status" class="resource-status" role="status" aria-live="polite"></p>
</section>
<script>
  const resourceRoot = document.querySelector('.resource-console');
  if (resourceRoot) {
    const list = resourceRoot.querySelector('#resource-list'); const status = resourceRoot.querySelector('#resource-status');
    const loadResources = async () => { status.textContent = 'Lendo metadados protegidos…'; try { const input = encodeURIComponent(JSON.stringify({ json: {} })); const response = await fetch(`/api/trpc/resources.list?input=${input}`, { credentials: 'include' }); const payload = await response.json(); if (!response.ok || payload.error) throw new Error(payload.error?.json?.message || payload.error?.message || 'Acesso restrito ao produtor.'); const resources = payload.result?.data?.json ?? payload.result?.data ?? []; list.replaceChildren(); if (!resources.length) { list.innerHTML = '<span class="ops-muted">Nenhum recurso versionado ainda.</span>'; } else resources.forEach(resource => { const item = document.createElement('div'); item.className = 'resource-row'; item.innerHTML = `<div><strong>${resource.fileName}</strong><small>${resource.mimeType} · ${Math.round((resource.sizeBytes || 0) / 1024)} KB</small></div><span>v${resource.version} · ${resource.visibility}</span>`; list.append(item); }); status.textContent = `${resources.length} recurso(s) auditado(s).`; } catch (error) { list.innerHTML = '<span class="ops-muted">Faça login para carregar a biblioteca.</span>'; status.textContent = error.message; status.dataset.error = 'true'; } };
    resourceRoot.querySelector('#resource-refresh')?.addEventListener('click', loadResources); loadResources();
  }
</script>
<style>
  .resource-console { margin-top:14px; padding:24px; border-radius:20px; } .resource-head { display:flex; justify-content:space-between; gap:18px; align-items:start; } .resource-head h2 { margin:9px 0 8px; font-size:clamp(22px,3vw,31px); letter-spacing:-.05em; } .resource-head p { margin:0; color:#71857a; font-size:12px; } .resource-list { display:grid; gap:0; margin-top:20px; } .resource-row { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:13px 0; border-top:1px solid rgba(255,255,255,.07); color:#9fecc9; font:10px 'DM Mono',monospace; } .resource-row strong,.resource-row small { display:block; } .resource-row strong { color:#d9e9e0; font:12px Inter,sans-serif; } .resource-row small { margin-top:4px; color:#71857a; font:10px 'DM Mono',monospace; } .resource-status { min-height:15px; margin:13px 0 0; color:#5ee4b1; font:10px 'DM Mono',monospace; } .resource-status[data-error=true] { color:#ff9b9b; } @media(max-width:720px){ .resource-console { padding:17px; } .resource-head { display:block; } .resource-head .secondary { margin-top:14px; } .resource-row { align-items:start; flex-direction:column; } }
</style>
