<section class="automation-console glass" aria-labelledby="automation-console-title">
  <div class="automation-console-head"><div><span class="eyebrow">DUCK STUDIO / EVENTOS</span><h2 id="automation-console-title">Planejar o próximo movimento.</h2><p>Simule o fluxo antes de ativar qualquer integração externa.</p></div><span class="automation-live">PLANNER ONLINE</span></div>
  <form id="automation-form" class="automation-form">
    <label>Evento<select name="type"><option value="order.paid">Pagamento aprovado</option><option value="file.received">Arquivo recebido</option><option value="revision.comment.created">Comentário de revisão</option><option value="revision.approved">Revisão aprovada</option><option value="project.overdue">Projeto vencido</option></select></label>
    <label>Tentativas<input name="attempts" type="number" min="0" max="20" value="0" /></label>
    <label>Entidade<input name="entityId" type="number" min="1" value="1" aria-label="ID da entidade" /></label>
    <label class="check-label"><input name="approvalGranted" type="checkbox" /> Aprovação concedida</label>
    <button class="primary" type="submit">Planejar fluxo →</button>
  </form>
  <div id="automation-result" class="automation-result" role="status" aria-live="polite"><span class="ops-muted">Escolha um evento para visualizar as ações seguras.</span></div>
</section>
<script>
  const automationRoot = document.querySelector('.automation-console');
  if (automationRoot) {
    const form = automationRoot.querySelector('#automation-form'); const result = automationRoot.querySelector('#automation-result');
    form?.addEventListener('submit', async event => { event.preventDefault(); const data = new FormData(form); result.textContent = 'Calculando ações…'; try { const input = { type: data.get('type'), attempts: Number(data.get('attempts') || 0), approvalGranted: data.get('approvalGranted') === 'on' }; const response = await fetch(`/api/trpc/automation.plan?input=${encodeURIComponent(JSON.stringify({ json: input }))}`, { credentials: 'include' }); const payload = await response.json(); if (!response.ok || payload.error) throw new Error(payload.error?.json?.message || payload.error?.message || 'Acesso restrito ao produtor.'); const plan = payload.result?.data?.json ?? payload.result?.data; let execution = ''; if (input.approvalGranted && plan.actions[0] !== 'open_exception') { const executeResponse = await fetch('/api/trpc/automation.execute', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ json: { ...input, entityType: 'automation', entityId: Number(data.get('entityId') || 1) } }) }); const executePayload = await executeResponse.json(); if (!executeResponse.ok || executePayload.error) throw new Error(executePayload.error?.json?.message || executePayload.error?.message || 'Execução bloqueada.'); execution = '<small>Execução registrada no log de atividade.</small>'; } result.innerHTML = `<b>${plan.type}</b><small>Orçamento: ${plan.budget} · ${plan.actions.length} ação(ões)</small><ul>${plan.actions.map(action => `<li>${action}</li>`).join('')}</ul>${execution}`; } catch (error) { result.textContent = error.message; result.dataset.error = 'true'; } });
  }
</script>
<style>
  .automation-console { margin-top:14px; padding:24px; border-radius:20px; } .automation-console-head { display:flex; align-items:start; justify-content:space-between; gap:18px; } .automation-console h2 { margin:9px 0 8px; font-size:clamp(22px,3vw,31px); letter-spacing:-.05em; } .automation-console p { margin:0; color:#71857a; font-size:12px; } .automation-live { color:#5ee4b1; font:10px 'DM Mono',monospace; } .automation-form { display:grid; grid-template-columns:1.5fr .5fr .6fr 1fr auto; align-items:end; gap:10px; margin-top:22px; } .automation-form label { display:grid; gap:6px; color:#84998c; font:10px 'DM Mono',monospace; } .automation-form select,.automation-form input[type=number] { min-width:0; padding:11px; border:1px solid rgba(255,255,255,.1); border-radius:9px; color:#cfe0d7; background:#07150f; font-size:11px; } .check-label { display:flex !important; grid-template-columns:auto 1fr; align-items:center; gap:8px !important; height:39px; } .check-label input { accent-color:#5ee4b1; } .automation-form .primary { border:0; cursor:pointer; padding:11px 13px; font-size:10px; } .automation-result { margin-top:18px; padding:14px; border:1px solid rgba(94,228,177,.14); border-radius:12px; color:#9fecc9; background:rgba(52,211,153,.04); font-size:11px; } .automation-result small,.automation-result ul { display:block; margin-top:7px; color:#71857a; } .automation-result ul { padding-left:16px; } .automation-result[data-error=true] { color:#ff9b9b; } @media(max-width:720px){ .automation-form { grid-template-columns:1fr; } .automation-console-head { display:block; } .automation-live { display:block; margin-top:12px; } .automation-form { grid-template-columns:1fr; } }
</style>
