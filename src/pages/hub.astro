---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import VisualObject from "../components/VisualObject.astro";
import AudioDeck from "../components/AudioDeck.astro";
import OperationsConsole from "../components/OperationsConsole.astro";
---
<BaseLayout title="Hub operacional" description="Painel operacional do produtor Duck">
  <Nav active="/hub" />
  <main class="shell hub-page">
    <section class="hub-heading"><div><span class="eyebrow">DUCK HUB / COMANDO</span><h1 data-i18n="studioControl">O estúdio, sob controle.</h1><p data-i18n="hubLead">Um núcleo simples para clientes, projetos, arquivos e receita.</p></div><a href="/catalog" class="primary focus-ring" data-i18n="openCatalog">Abrir catálogo →</a></section>
    <section class="visual-strip"><VisualObject src="/manus-storage/duck-scanner-belentani_81440639.png" alt="Scanner Belentani circular com anéis de espectro em verde esmeralda" label="SCANNER BELENTANI / SINAL" mode="scanner" aspect="square" /><div class="visual-note glass"><span class="eyebrow" data-i18n="mutableProtocol">VARIAÇÃO VISUAL</span><strong data-i18n="pulseChanges">O pulso muda. O sistema permanece.</strong><p data-i18n="pulseDescription">Alterne a variação do objeto para revelar diferentes leituras do mesmo estúdio.</p><AudioDeck label="DUCK HUB / PLAYHEAD" variant="timeline" compact /></div></section>
    <section class="metric-grid"><article class="glass metric"><span data-i18n="activeClients">CLIENTES ATIVOS</span><strong>08</strong><small data-i18n="cycleDelta">+2 neste ciclo</small></article><article class="glass metric"><span data-i18n="projectsInProgress">PROJETOS EM CURSO</span><strong>04</strong><small data-i18n="oneReview">1 em revisão</small></article><article class="glass metric"><span data-i18n="cycleRevenue">RECEITA DO CICLO</span><strong>R$ 4.280</strong><small data-i18n="revenueDelta">+18% vs. anterior</small></article><article class="glass metric"><span data-i18n="operationalHealth">SAÚDE OPERACIONAL</span><strong>92%</strong><small data-i18n="withinProtocol">Dentro do protocolo</small></article></section>
    <section class="hub-grid"><article class="glass panel"><div class="panel-head"><div><span class="eyebrow" data-i18n="nextMoves">PRÓXIMOS MOVIMENTOS</span><h2 data-i18n="productionQueue">Fila de produção</h2></div><a href="/ferramentas" data-i18n="viewAll">Ver tudo →</a></div><div class="queue"><div><span class="queue-icon">♫</span><div><b>EP — Gema 01</b><small><span data-i18n="mixReview">Revisão de mix</span> · <span data-i18n="today">Hoje, 16:00</span></small></div><em data-i18n="review">REVISÃO</em></div><div><span class="queue-icon">◈</span><div><b>Campanha Recife</b><small><span data-i18n="sendStems">Enviar stems</span> · <span data-i18n="tomorrow">Amanhã</span></small></div><em class="muted" data-i18n="delivery">ENTREGA</em></div><div><span class="queue-icon">✦</span><div><b>Novo lead / João</b><small><span data-i18n="replyBriefing">Responder briefing</span> · <span data-i18n="days2">2 dias</span></small></div><em class="muted" data-i18n="lead">LEAD</em></div></div></article><article class="glass panel"><div class="panel-head"><div><span class="eyebrow" data-i18n="currentCycle">CICLO ATUAL</span><h2 data-i18n="operationFocus">Operação em foco</h2></div><span class="percentage">68%</span></div><div class="big-progress"><span></span></div><div class="check-list"><span data-i18n="definedClient">✓ Cliente definido</span><span data-i18n="referencesReceived">✓ Referências recebidas</span><span data-i18n="firstVersion">✓ Primeira versão enviada</span><span class="pending" data-i18n="finalDelivery">○ Entrega final</span></div><a class="secondary focus-ring full" href="/ferramentas" data-i18n="checklist">Abrir checklist →</a></article></section>
    <section class="quick-links"><a class="glass quick" href="/catalog"><span>♫</span><b data-i18n="beatShop">Loja de beats</b><small data-i18n="licensesDelivery">Licenças e checkout</small></a><a class="glass quick" href="/ferramentas"><span>✦</span><b data-i18n="tools">Ferramentas</b><small data-i18n="resources">Automações do Duck</small></a><a class="glass quick" href="/"><span>⌁</span><b data-i18n="protocol">Protocolo</b><small data-i18n="returnMission">Retornar à missão</small></a></section>
    <OperationsConsole />
  </main>
</BaseLayout>
<style>
  .hub-page { padding:64px 0 110px; }
  .eyebrow { color:#55ddb0; font:500 10px 'DM Mono',monospace; letter-spacing:.2em; }
  .hub-heading { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:30px; }
  h1 { margin:12px 0 8px; font-size:clamp(34px,5vw,62px); letter-spacing:-.06em; }
  .hub-heading p { margin:0; color:#789084; font-size:14px; }
  .primary, .secondary { display:inline-flex; align-items:center; gap:10px; padding:13px 17px; border-radius:11px; text-decoration:none; font-size:12px; font-weight:700; white-space:nowrap; }
  .primary { color:#04100a; background:#5ee4b1; } .secondary { border:1px solid rgba(255,255,255,.1); color:#a8bab0; background:rgba(255,255,255,.03); }
  .visual-strip { display:grid; grid-template-columns:minmax(180px,.35fr) 1fr; gap:16px; margin-bottom:16px; } .visual-strip :global(.visual-object) { min-height:190px; } .visual-note { display:flex; flex-direction:column; justify-content:center; padding:24px; border-radius:20px; } .visual-note strong { max-width:360px; margin-top:14px; font-size:clamp(20px,3vw,34px); letter-spacing:-.05em; } .visual-note p { max-width:420px; margin:12px 0 0; color:#789084; font-size:13px; line-height:1.7; }
  .metric-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
  .metric { padding:20px; border-radius:16px; } .metric span,.metric small { display:block; color:#71857a; font-size:10px; letter-spacing:.12em; } .metric strong { display:block; margin:15px 0 5px; font-size:27px; letter-spacing:-.05em; } .metric small { color:#53dba9; letter-spacing:0; }
  .hub-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:16px; margin-top:16px; }
  .panel { min-height:350px; padding:23px; border-radius:20px; } .panel-head { display:flex; justify-content:space-between; gap:15px; align-items:start; } .panel h2 { margin:9px 0 0; font-size:21px; letter-spacing:-.04em; } .panel-head a { color:#69e5b8; font-size:11px; text-decoration:none; }
  .queue { display:grid; gap:0; margin-top:28px; } .queue > div { display:grid; grid-template-columns:38px 1fr auto; align-items:center; gap:12px; padding:17px 0; border-top:1px solid rgba(255,255,255,.07); } .queue-icon { display:grid; place-items:center; width:38px; height:38px; border-radius:12px; color:#62e5b4; background:rgba(52,211,153,.1); } .queue b,.queue small { display:block; } .queue b { font-size:13px; } .queue small { margin-top:4px; color:#74877e; font-size:11px; } .queue em { color:#5ee4b1; font:10px 'DM Mono',monospace; font-style:normal; } .queue em.muted { color:#73877d; }
  .percentage { color:#5ee4b1; font:16px 'DM Mono',monospace; } .big-progress { height:8px; margin-top:40px; border-radius:99px; background:rgba(255,255,255,.08); } .big-progress span { display:block; width:68%; height:100%; border-radius:inherit; background:#5ee4b1; } .check-list { display:grid; gap:14px; margin:24px 0 28px; color:#a7c2b3; font-size:12px; } .check-list .pending { color:#71857a; } .full { justify-content:center; width:100%; }
  .quick-links { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:16px; } .quick { display:grid; grid-template-columns:42px 1fr; column-gap:12px; align-items:center; padding:17px; border-radius:16px; color:inherit; text-decoration:none; } .quick span { grid-row:span 2; display:grid; place-items:center; width:42px; height:42px; border-radius:13px; color:#5ee4b1; background:rgba(52,211,153,.1); font-size:20px; } .quick b { font-size:13px; } .quick small { color:#71857a; font-size:11px; }
  @media (max-width:720px) { .hub-page { padding-top:45px; } .visual-strip { grid-template-columns:1fr; } .visual-strip :global(.visual-object) { max-height:240px; }
 .hub-heading { align-items:start; flex-direction:column; } .metric-grid { grid-template-columns:repeat(2,1fr); } .metric { padding:16px; } .metric strong { font-size:22px; } .hub-grid { grid-template-columns:1fr; } .panel { min-height:auto; } .quick-links { grid-template-columns:1fr; } }
</style>
