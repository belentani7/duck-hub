---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import VisualObject from "../components/VisualObject.astro";
import AudioDeck from "../components/AudioDeck.astro";
import AutomationConsole from "../components/AutomationConsole.astro";
import ResourceConsole from "../components/ResourceConsole.astro";
---
<BaseLayout title="Ferramentas" description="Ferramentas operacionais do Duck Hub">
  <Nav active="/ferramentas" />
  <main class="shell tools-page">
    <section class="tools-heading"><div><span class="eyebrow">DUCK HUB / <span data-i18n="tools">FERRAMENTAS</span></span><h1><span data-i18n="lessNoise">Menos ruído.</span><br /><em data-i18n="moreCommand">Mais comando.</em></h1><p data-i18n="toolsLead">Recursos para transformar uma ideia em entrega rastreável.</p></div><a class="primary focus-ring" href="/hub" data-i18n="backHub">Voltar ao Hub →</a></section>
    <section class="tool-visuals"><VisualObject src="/manus-storage/duck-delivery-fader_a93fc33b.png" alt="Módulo de faders com cinco etapas de entrega e luzes verdes" label="FADER / ENTREGA" mode="fader" aspect="wide" /><VisualObject src="/manus-storage/duck-selo-recife_2cc3f725.png" alt="Selo metálico geométrico sobre pedra escura com luz verde" label="RECIFE / IDENTIDADE" mode="selo" aspect="portrait" /><AudioDeck label="DUCK TOOLS / FLOW" variant="spectrum" compact /></section>
    <section class="tool-grid"><article class="glass tool"><span class="tool-icon">⌁</span><span class="eyebrow">01 / <span data-i18n="projectCategory">PROJETO</span></span><h2 data-i18n="deliveryChecklist">Checklist de entrega</h2><p data-i18n="checklistText">Mix, master, stems, metadados, contrato e publicação em uma sequência clara.</p><a class="tool-action focus-ring" href="/hub#ops-title" data-i18n="activateFlow">Ativar fluxo →</a></article><article class="glass tool"><span class="tool-icon">✦</span><span class="eyebrow">02 / <span data-i18n="operationCategory">OPERAÇÃO</span></span><h2 data-i18n="duckAutomations">Automações do Duck</h2><p data-i18n="automationText">Eventos para pagamentos, arquivos, revisões e acompanhamento de prazos.</p><a class="tool-action focus-ring" href="#automation-console-title" data-i18n="configureEvent">Configurar evento →</a></article><article class="glass tool"><span class="tool-icon">◈</span><span class="eyebrow">03 / <span data-i18n="resourcesCategory">RECURSOS</span></span><h2 data-i18n="protectedLibrary">Biblioteca protegida</h2><p data-i18n="libraryText">Stems, presets, referências e contratos organizados com URLs assinadas.</p><a class="tool-action focus-ring" href="/catalog" data-i18n="openLibrary">Abrir biblioteca →</a></article><article class="glass tool"><span class="tool-icon">♫</span><span class="eyebrow">04 / <span data-i18n="analysisCategory">ANÁLISE</span></span><h2 data-i18n="sessionHealth">Saúde da sessão</h2><p data-i18n="sessionText">Veja prazo, revisões usadas, arquivos pendentes e o próximo movimento.</p><a class="tool-action focus-ring" href="/hub#ops-title" data-i18n="viewDiagnosis">Ver diagnóstico →</a></article></section>
    <AutomationConsole />
    <ResourceConsole />
    <section class="automation-blueprint glass" aria-labelledby="blueprint-title"><div class="panel-head"><div><span class="eyebrow" data-i18n="systemStatus">STATUS DO SISTEMA</span><h2 id="blueprint-title" data-i18n="flowsReady">Os fluxos estão preparados.</h2></div><span class="blueprint-tag" data-i18n="externalApproval">Aguardando aprovação</span></div><div class="blueprint-grid"><article><span>01</span><b data-i18n="deliveryChecklist">Checklist de entrega</b><small data-i18n="checklistText">Mix, master, stems, metadados, contrato e publicação em uma sequência clara.</small></article><article><span>02</span><b data-i18n="duckAutomations">Automações do Duck</b><small data-i18n="automationText">Eventos para pagamentos, arquivos, revisões e acompanhamento de prazos.</small></article><article><span>03</span><b data-i18n="protectedLibrary">Biblioteca protegida</b><small data-i18n="libraryText">Stems, presets, referências e contratos organizados com URLs assinadas.</small></article><article><span>04</span><b data-i18n="sessionHealth">Saúde da sessão</b><small data-i18n="sessionText">Veja prazo, revisões usadas, arquivos pendentes e o próximo movimento.</small></article></div><div class="automation-status"><span class="pulse"></span><b data-i18n="backendOnline">BACKEND ONLINE</b><small>tRPC · Storage · Auth</small></div></section>
  </main>
</BaseLayout>
<style>
  .tools-page { padding:64px 0 110px; } .tool-visuals { display:grid; grid-template-columns:1.55fr .45fr; gap:14px; margin-top:34px; } .tool-visuals :global(.audio-deck) { grid-column:1 / -1; } .tool-visuals :global(.visual-object) { min-height:170px; } .tool-visuals :global(.visual-portrait) { min-height:170px; } .tools-heading { display:flex; align-items:end; justify-content:space-between; gap:25px; } .eyebrow { color:#55ddb0; font:500 10px 'DM Mono',monospace; letter-spacing:.2em; } h1 { margin:14px 0; font-size:clamp(44px,6vw,76px); line-height:.98; letter-spacing:-.07em; } h1 em { color:#5ee4b1; font-style:normal; } .tools-heading p { margin:0; color:#7e9287; font-size:14px; } .primary { display:inline-flex; padding:13px 17px; border-radius:11px; color:#04100a; background:#5ee4b1; text-decoration:none; font-size:12px; font-weight:700; white-space:nowrap; } .tool-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; margin-top:48px; } .tool { padding:23px; border-radius:20px; } .tool-icon { display:grid; place-items:center; width:45px; height:45px; margin-bottom:28px; border-radius:14px; color:#5ee4b1; background:rgba(52,211,153,.1); font-size:22px; } .tool h2 { margin:12px 0 8px; font-size:22px; letter-spacing:-.04em; } .tool p { min-height:45px; margin:0; color:#758980; font-size:13px; line-height:1.7; } .tool-action { margin-top:25px; border:0; padding:0; color:#68e5b7; background:none; cursor:pointer; font-size:12px; font-weight:700; } .automation-blueprint { margin-top:14px; padding:24px; border-radius:20px; } .automation-blueprint .panel-head { display:flex; align-items:center; justify-content:space-between; gap:16px; } .automation-blueprint h2 { margin:10px 0 7px; font-size:22px; } .blueprint-tag { color:#a7eccc; font:10px 'DM Mono',monospace; text-transform:uppercase; } .blueprint-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:22px; } .blueprint-grid article { min-height:142px; padding:15px; border:1px solid rgba(52,211,153,.14); border-radius:15px; background:rgba(7,27,18,.45); } .blueprint-grid span { display:block; color:#5ee4b1; font:10px 'DM Mono',monospace; } .blueprint-grid b { display:block; margin:21px 0 8px; font-size:13px; } .blueprint-grid small { display:block; color:#758980; font-size:11px; line-height:1.55; } .automation-status { min-width:150px; margin-top:18px; padding:15px; border:1px solid rgba(52,211,153,.18); border-radius:13px; } .pulse { display:inline-block; width:8px; height:8px; margin-right:7px; border-radius:50%; background:#5ee4b1; box-shadow:0 0 13px #5ee4b1; } .automation-status b,.automation-status small { display:block; } .automation-status b { color:#9fecc9; font:10px 'DM Mono',monospace; } .automation-status small { margin-top:8px; color:#71857a; font-size:10px; } @media(max-width:720px){ .tools-page{padding-top:46px;} .tool-visuals { grid-template-columns:1fr; } .tool-visuals :global(.visual-object) { min-height:180px; } .tool-visuals :global(.visual-portrait) { min-height:210px; max-height:280px; }
 .tools-heading{display:block;} .tool-visuals :global(.audio-deck) { grid-column:auto; } .tools-heading .primary{margin-top:25px;} .tool-grid{grid-template-columns:1fr; margin-top:35px;} .tool p{min-height:auto;} .automation-blueprint .panel-head{display:block;} .blueprint-tag{display:block; margin-top:12px;} .blueprint-grid{grid-template-columns:1fr 1fr;} .automation-status{margin-top:22px;} }
</style>
