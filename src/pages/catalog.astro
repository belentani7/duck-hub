---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import BeatGrid from "../components/BeatGrid.astro";
import VisualObject from "../components/VisualObject.astro";
---
<BaseLayout title="Loja de beats" description="Catálogo de beats do Duck">
  <Nav active="/catalog" />
  <main class="shell catalog-page">
    <section class="catalog-hero"><div><span class="eyebrow">DUCK / <span data-i18n="catalog">CATÁLOGO</span> <span data-i18n="publicLabel">PÚBLICO</span></span><h1 data-i18n="nextVersion">Instrumentais para desbloquear sua próxima versão.</h1><p data-i18n="catalogLead">Previews protegidos, licenças claras e entrega segura. Escolha o caminho da sua próxima faixa.</p></div><div class="catalog-note glass"><span>◈</span><b data-i18n="assetProtocol">PROTOCOLO DE ATIVO</b><small><span data-i18n="watermark">Watermark antes da decisão.</span><br /><span data-i18n="signedUrl">URL assinada depois da confirmação.</span></small></div></section>
    <section class="catalog-object"><VisualObject src="/manus-storage/duck-stems-cartridge_89c01787.png" alt="Cartucho de stems protegido em vidro escuro com ondas de áudio verdes" label="STEMS / ARQUIVO PROTEGIDO" mode="stems" aspect="wide" /><div><span class="eyebrow" data-i18n="protectedFiles">ARQUIVOS PROTEGIDOS</span><h2 data-i18n="visualWatermarkTitle">Watermark antes da decisão.</h2><p data-i18n="visualWatermarkText">O objeto visual acompanha a mesma regra do catálogo: revelar contexto, preservar o ativo e entregar o arquivo somente após a confirmação.</p><div class="catalog-wave" role="img" aria-label="Visualização de waveform do preview protegido">{Array.from({ length: 24 }, (_, index) => <i style={`--wave-index:${index}`}></i>)}</div></div></section>
    <BeatGrid />
  </main>
</BaseLayout>
<style>
  .catalog-page { padding:64px 0 90px; } .catalog-object { display:grid; grid-template-columns:1fr 1fr; gap:22px; align-items:center; margin:28px 0 36px; } .catalog-object :global(.visual-object) { min-height:210px; } .catalog-wave { display:flex; align-items:center; gap:3px; height:58px; margin-top:18px; padding:12px 14px; border:1px solid rgba(167,243,208,.12); border-radius:12px; background:rgba(3,12,8,.72); overflow:hidden; } .catalog-wave i { flex:1; height:calc(22% + (var(--wave-index) * 3%)); min-width:2px; border-radius:3px; background:linear-gradient(180deg,#9af4ca,#1e9465); animation:catalog-wave 1.4s ease-in-out infinite alternate; animation-delay:calc(var(--wave-index) * -45ms); } .catalog-wave i:nth-child(3n) { height:72%; } .catalog-wave i:nth-child(4n) { height:38%; } @keyframes catalog-wave { from { transform:scaleY(.6); opacity:.45; } to { transform:scaleY(1); opacity:.9; } } .catalog-object h2 { margin:12px 0 8px; font-size:clamp(23px,3.5vw,40px); letter-spacing:-.06em; } .catalog-object p { max-width:480px; margin:0; color:#7e9287; font-size:13px; line-height:1.75; } .catalog-hero { display:flex; align-items:end; justify-content:space-between; gap:30px; } .eyebrow { color:#55ddb0; font:500 10px 'DM Mono',monospace; letter-spacing:.2em; } h1 { max-width:730px; margin:14px 0 15px; font-size:clamp(38px,5.7vw,74px); line-height:1; letter-spacing:-.07em; } h1 em { color:#5ee4b1; font-style:normal; } .catalog-hero p { max-width:540px; margin:0; color:#7e9287; font-size:14px; line-height:1.75; } .catalog-note { display:grid; grid-template-columns:32px 1fr; column-gap:10px; min-width:220px; padding:17px; border-radius:16px; } .catalog-note span { grid-row:span 2; color:#5ee4b1; font-size:24px; } .catalog-note b,.catalog-note small { display:block; } .catalog-note b { color:#aeeed0; font:10px 'DM Mono',monospace; letter-spacing:.12em; } .catalog-note small { margin-top:8px; color:#71857a; font-size:11px; line-height:1.55; } @media(max-width:720px){ .catalog-page{padding-top:46px;} .catalog-hero{display:block;} .catalog-note{margin-top:26px;} .catalog-object { display:flex; flex-direction:column; gap:18px; margin-top:24px; } .catalog-object > div { width:100%; } .catalog-object :global(.visual-object) { min-height:180px; } .catalog-wave { height:50px; margin-top:14px; } }
</style>
