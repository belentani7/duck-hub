---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import VisualObject from "../components/VisualObject.astro";
import AudioDeck from "../components/AudioDeck.astro";
---
<BaseLayout title="Missão" description="A entrada secreta do Duck Hub">
  <Nav active="/" />
  <main class="shell mission">
    <section class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow" data-i18n="restricted">TRANSMISSÃO RESTRITA · 01 / 05</span>
        <h1><span data-i18n="productionSecret">A produção é o segredo.</span><br /><em data-i18n="systemKey">O sistema é a chave.</em></h1>
        <p data-i18n="missionLead">Uma missão para transformar o caos invisível de um estúdio em um fluxo que pode ser entendido, protegido e entregue.</p>
        <div class="hero-actions"><a class="primary focus-ring" href="/hub" data-i18n="startTransmission">Iniciar transmissão →</a><a class="secondary focus-ring" href="#protocolo" data-i18n="seeProtocol">Ver protocolo ↓</a></div>
      </div>
      <div class="signal glass">
        <div class="signal-top"><span><i></i> <span data-i18n="secureChannel">CANAL SEGURO</span></span><b class="mono">01 / 05</b></div>
        <div class="signal-core"><span class="signal-icon">⌁</span><span class="eyebrow">01 / <span data-i18n="signal">SINAL</span></span><h2 data-i18n="signalFound">O sinal foi encontrado</h2><p data-i18n="unifiedLead">Duck Hub é o núcleo operacional de um produtor: clientes, projetos, arquivos, beats e pagamentos deixam de viver em ilhas separadas.</p><VisualObject src="/manus-storage/duck-gema-01_ba17f467.png" alt="Sintetizador Gema 01 com luzes verdes sobre uma bancada escura" label="GEMA 01 / ESTUDO" mode="gema" aspect="wide" /><AudioDeck label="DUCK STUDIO / SESSÃO" variant="spectrum" compact /></div>
        <div class="progress"><span></span><i></i><i></i><i></i><i></i></div>
      </div>
    </section>
    <section class="command-deck" aria-labelledby="command-title">
      <div><span class="eyebrow" data-i18n="unifiedCore">NÚCLEO UNIFICADO</span><h2 id="command-title" data-i18n="oneMission">Uma missão. Quatro canais.</h2><p data-i18n="unifiedLead">Entre pelo protocolo e escolha o próximo movimento sem sair do mesmo sistema.</p></div>
      <div class="command-links"><a class="command-link focus-ring" href="/hub"><span>◈</span><b data-i18n="operationalHub">Hub operacional</b><small data-i18n="clientsProjects">Clientes · projetos · receita</small> →</a><a class="command-link focus-ring" href="/catalog"><span>♫</span><b data-i18n="beatsStore">Loja de beats</b><small data-i18n="licensesDelivery">Licenças · previews · entrega</small> →</a><a class="command-link focus-ring" href="/ferramentas"><span>✦</span><b data-i18n="tools">Ferramentas</b><small data-i18n="resources">Recursos · automações · checklist</small> →</a></div>
    </section>
    <section id="protocolo" class="protocol-grid">
      <article class="glass protocol"><span>01</span><h3 data-i18n="realCore">Núcleo real</h3><p data-i18n="realCoreText">Banco de dados, autenticação e regras de acesso não são decorativos.</p></article>
      <article class="glass protocol"><span>02</span><h3 data-i18n="protectedFiles">Arquivos protegidos</h3><p data-i18n="protectedFilesText">Cada entrega pode ser versionada e distribuída por URL assinada.</p></article>
      <article class="glass protocol"><span>03</span><h3 data-i18n="persistentMission">Missão persistente</h3><p data-i18n="persistentMissionText">Seu progresso fica persistido para usuários autenticados.</p></article>
    </section>
  </main>
</BaseLayout>
<style>
  .mission { padding:clamp(60px,10vw,120px) 0 90px; }
  .hero-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:clamp(32px,7vw,88px); align-items:center; }
  .eyebrow { color:#55ddb0; font:500 10px 'DM Mono',monospace; letter-spacing:.22em; }
  h1 { margin:22px 0 25px; max-width:600px; font-size:clamp(45px,6.4vw,86px); line-height:.98; letter-spacing:-.07em; }
  h1 em { color:#58e5b2; font-style:normal; }
  .hero-copy > p { max-width:470px; color:#81938a; font-size:15px; line-height:1.75; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:32px; }
  .primary, .secondary { display:inline-flex; align-items:center; gap:12px; padding:13px 17px; border-radius:11px; text-decoration:none; font-size:12px; font-weight:700; }
  .primary { color:#04100a; background:#5ee4b1; }
  .secondary { border:1px solid rgba(255,255,255,.1); color:#a8bab0; background:rgba(255,255,255,.03); }
  .signal { padding:24px; border-radius:28px; }
  .signal-top { display:flex; justify-content:space-between; padding-bottom:20px; border-bottom:1px solid rgba(255,255,255,.07); color:#687c72; font:10px 'DM Mono',monospace; letter-spacing:.2em; }
  .signal-top i { display:inline-block; width:8px; height:8px; margin-right:8px; border-radius:50%; background:#5ee4b1; box-shadow:0 0 16px #5ee4b1; }
  .signal-top b { color:#63e4b3; font-weight:400; letter-spacing:.08em; }
  .signal-core { padding:70px 5px 64px; }
  .signal-icon { display:grid; place-items:center; width:56px; height:56px; margin-bottom:28px; border-radius:16px; color:#58e5b2; background:rgba(52,211,153,.1); font-size:28px; }
  .signal h2 { margin:16px 0 12px; font-size:clamp(28px,4vw,44px); letter-spacing:-.05em; }
  .signal p { max-width:600px; margin:0; color:#84958d; font-size:14px; line-height:1.75; } .signal-core :global(.visual-object) { margin-top:24px; min-height:150px; }
  .progress { display:grid; grid-template-columns:1fr 1fr 1fr 1fr 1fr; gap:8px; }
  .progress span, .progress i { height:6px; border-radius:99px; background:rgba(255,255,255,.08); }
  .progress span { background:#5ee4b1; }
  .command-deck { display:grid; grid-template-columns:.75fr 1.25fr; gap:24px; align-items:center; margin-top:66px; padding:24px; border:1px solid rgba(52,211,153,.16); border-radius:22px; background:rgba(52,211,153,.045); } .command-deck h2 { margin:10px 0 8px; font-size:24px; letter-spacing:-.04em; } .command-deck p { margin:0; color:#71857a; font-size:12px; line-height:1.65; } .command-links { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; } .command-link { display:grid; grid-template-columns:30px 1fr auto; column-gap:8px; align-items:center; padding:13px; border:1px solid rgba(255,255,255,.08); border-radius:13px; color:inherit; text-decoration:none; background:rgba(0,0,0,.15); } .command-link span { grid-row:span 2; display:grid; place-items:center; width:30px; height:30px; border-radius:9px; color:#5ee4b1; background:rgba(52,211,153,.1); } .command-link b,.command-link small { display:block; } .command-link b { font-size:11px; } .command-link small { margin-top:4px; color:#71857a; font-size:9px; } .command-link::after { content:'→'; color:#5ee4b1; } .protocol-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:88px; padding-top:26px; border-top:1px solid rgba(255,255,255,.07); }
  .protocol { padding:22px; border-radius:18px; }
  .protocol span { color:#5ee4b1; font:10px 'DM Mono',monospace; }
  .protocol h3 { margin:26px 0 8px; font-size:16px; }
  .protocol p { margin:0; color:#71857a; font-size:12px; line-height:1.7; }
  @media (max-width:720px) { .mission { padding-top:54px; } .hero-grid { grid-template-columns:1fr; } .hero-copy > p { font-size:14px; } .signal-core { padding:42px 0 38px; } .signal { padding:18px; border-radius:22px; } .command-deck { grid-template-columns:1fr; margin-top:48px; padding:18px; } .command-links { grid-template-columns:1fr; } .protocol-grid { grid-template-columns:1fr; margin-top:60px; } .protocol { min-height:128px; } }
</style>
